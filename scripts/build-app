#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
identity=""
adhoc=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --sign) identity="${2:?--sign requires an identity}"; shift 2 ;;
    --adhoc) adhoc=1; shift ;;
    *) echo "Usage: scripts/build-app [--adhoc | --sign IDENTITY]" >&2; exit 2 ;;
  esac
done
[[ "$adhoc" != 1 || -z "$identity" ]] || { echo "--adhoc and --sign conflict" >&2; exit 2; }

source_icon="$root/macos/Natterwire/Assets/NatterwireIcon.png"
[[ -f "$source_icon" ]] || {
  echo "Missing revised icon source: $source_icon" >&2
  exit 1
}

swift build --package-path "$root" -c release
app="$root/dist/Natterwire.app"
contents="$app/Contents"
resources="$contents/Resources"
icon_output="$root/macos/Natterwire/Resources/AppIcon.icns"
rm -rf "$app"
mkdir -p "$contents/MacOS" "$resources" "$(dirname "$icon_output")"
cp "$root/.build/release/natterwire" "$contents/MacOS/natterwire"
cp "$root/macos/Natterwire/Info.plist" "$contents/Info.plist"
chmod 700 "$contents/MacOS/natterwire"
plutil -lint "$contents/Info.plist" >/dev/null

icon_tmp="$(mktemp -d)"
trap 'rm -rf "$icon_tmp"' EXIT
iconset="$icon_tmp/AppIcon.iconset"
mkdir -p "$iconset"
while read -r pixels name; do
  sips -z "$pixels" "$pixels" "$source_icon" --out "$iconset/$name" >/dev/null
done <<'SIZES'
16 icon_16x16.png
32 icon_16x16@2x.png
32 icon_32x32.png
64 icon_32x32@2x.png
128 icon_128x128.png
256 icon_128x128@2x.png
256 icon_256x256.png
512 icon_256x256@2x.png
512 icon_512x512.png
1024 icon_512x512@2x.png
SIZES
iconutil -c icns "$iconset" -o "$icon_output"
cp "$icon_output" "$resources/AppIcon.icns"

if [[ "$adhoc" == 1 ]]; then
  identity="-"
elif [[ -z "$identity" ]]; then
  installed="$HOME/Applications/Natterwire.app"
  installed_identity="$(codesign -dvv "$installed" 2>&1 | awk -F= '/^Authority=/{print substr($0, index($0, "=") + 1); exit}' || true)"
  available="$(security find-identity -v -p codesigning 2>/dev/null || true)"
  if [[ -n "$installed_identity" && "$available" == *"\"$installed_identity\""* ]]; then
    identity="$installed_identity"
  else
    identity="$(printf '%s\n' "$available" | awk -F'"' '/Apple Development:/ {print $2; exit}')"
    identity="${identity:--}"
  fi
fi

codesign --force --options runtime \
  --entitlements "$root/macos/Natterwire/Natterwire.entitlements" \
  --sign "$identity" --timestamp=none "$app" >/dev/null
codesign --verify --deep --strict "$app"
printf '%s\n' "$app"
