#!/bin/bash
set -euo pipefail

# Install a reviewed copy as ~/.local/libexec/natterwire-deploy, then use it
# as this app's dedicated SSH key's forced command. Stdin is a signed app/TUI tar.
[[ ${SSH_ORIGINAL_COMMAND:-} =~ ^deploy\ ([0-9a-f]{40})$ ]] || {
  echo 'Expected: deploy <commit SHA>' >&2; exit 2;
}
revision=${BASH_REMATCH[1]}
[[ $(uname -s) == Darwin && $(id -un) == shardul ]] || {
  echo 'Deployment requires the shardul macOS login session' >&2; exit 1;
}
export PATH="/etc/profiles/per-user/shardul/bin:$HOME/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin:/usr/sbin:/sbin"
umask 077
work=$(mktemp -d "${TMPDIR:-/tmp}/natterwire-deploy.XXXXXX")
trap 'rm -rf "$work"' EXIT
/usr/bin/tar -xf - -C "$work"

app="$HOME/Applications/Natterwire.app"
incoming="$work/Natterwire.app"
backup="$HOME/Applications/Natterwire.app.previous"
# Pin the existing personal development certificate, including for the TUI.
requirement='=anchor apple generic and certificate leaf = H"5748468843D7D2316B51EF650D85B1ED8A1E7196"'
[[ ! -e "$backup" && ! -L "$backup" ]] || {
  echo "Inspect retained backup before retrying: $backup" >&2; exit 1;
}
for signed in "$app" "$incoming" "$work/natterwire-tui"; do
  [[ ! -L "$signed" ]]
  codesign --verify --deep --strict -R "$requirement" "$signed"
done
[[ $(plutil -extract CFBundleIdentifier raw -o - "$incoming/Contents/Info.plist") == com.shardul.natterwire.api ]]
[[ $(plutil -extract CFBundleExecutable raw -o - "$incoming/Contents/Info.plist") == natterwire-api ]]
for binary in "$incoming/Contents/MacOS/natterwire-api" "$work/natterwire-tui"; do
  go version -m "$binary" | grep -Fq "vcs.revision=$revision"
  "$binary" --help >/dev/null
done

# AppKit returns cancellation while our delegate stops its loop for Go cleanup.
/usr/bin/osascript <<'APPLESCRIPT'
try
  if application id "com.shardul.natterwire.api" is running then tell application id "com.shardul.natterwire.api" to quit
on error errorMessage number errorNumber
  if errorNumber is not -128 then error errorMessage number errorNumber
end try
APPLESCRIPT
# Do not replace the bundle while the previous executable is still running.
for _ in {1..30}; do
  pgrep -x natterwire-api >/dev/null || break
  sleep 1
done
if pgrep -x natterwire-api >/dev/null; then
  echo 'Natterwire did not quit; leaving installation untouched' >&2; exit 1
fi
mv "$app" "$backup"
mv "$incoming" "$app"
/usr/bin/open "$app"
# This exercises HTTP without printing chats, contacts, or session tokens.
curl --fail --silent --show-error --retry 15 --retry-connrefused --retry-delay 2 \
  --max-time 5 --output /dev/null http://127.0.0.1:8741/send-session
# Keep the old bundle on failure; only a healthy replacement can discard it.
mv -f "$work/natterwire-tui" "$HOME/.local/bin/natterwire-tui"
rm -rf "$backup"
echo "Installed natterwire $revision; relaunch existing TUI processes."
